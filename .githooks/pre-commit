#!/bin/bash
# .githooks/pre-commit
# 1. Blocks commits that modify any protected read-only document.
# 2. Runs CSharpier on all staged .cs files in a single batch call.
# Applies to every committer: Claude Code, humans, any tool.
#
# One-time setup (Sprint 0 Step 2 of CLAUDE.md):
#   git config core.hooksPath .githooks

echo ""
echo "  [pre-commit] Running..."

# ── PROTECTED FILES — abort if any of these are staged ────────────────────────
# These are read-only source-of-truth documents.
# No committer — human or AI — may modify them.
PROTECTED_FILES=(
    "CLAUDE.md"
    "TECH_SPEC.md"
    "ACCEPTANCE_TESTS.md"
    "PROJECT_PLAN.md"
)

PROTECTED_VIOLATION=0
for protected in "${PROTECTED_FILES[@]}"; do
    if git diff --cached --name-only | grep -qx "$protected"; then
        echo "  [pre-commit] BLOCKED: '$protected' is a protected read-only file."
        echo "               This file must not be modified by anyone or anything."
        PROTECTED_VIOLATION=1
    fi
done

if [ $PROTECTED_VIOLATION -ne 0 ]; then
    echo ""
    echo "  [pre-commit] Commit aborted. Unstage the protected file(s) and retry."
    echo "               To unstage:  git restore --staged <file>"
    echo ""
    exit 1
fi

echo "  [pre-commit] Protected files: OK."

# ── CSharpier — format staged .cs files ───────────────────────────────────────
STAGED_CS=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.cs$')

if [ -z "$STAGED_CS" ]; then
    echo "  [pre-commit] No .cs files staged. Nothing to format."
    echo ""
    exit 0
fi

# Build file list (skip any path that no longer exists on disk)
FILES=()
while IFS= read -r file; do
    if [ -f "$file" ]; then
        FILES+=("$file")
    fi
done <<< "$STAGED_CS"

FILE_COUNT=${#FILES[@]}
echo "  [pre-commit] $FILE_COUNT .cs file(s) to format:"
for f in "${FILES[@]}"; do
    echo "               $f"
done

# Format all files in one batch call.
# 'dotnet csharpier format' uses the dotnet CLI global tool dispatch —
# dotnet itself is always on PATH and handles finding the tool.
# No PATH manipulation needed.
dotnet csharpier format "${FILES[@]}" 2>&1
EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
    echo ""
    echo "  [pre-commit] ERROR: CSharpier failed (exit code $EXIT_CODE). Commit aborted."
    echo "               Resolve the error above and retry."
    echo ""
    exit 1
fi

# Re-stage the formatted files
for file in "${FILES[@]}"; do
    git add "$file"
done

echo "  [pre-commit] Done. $FILE_COUNT file(s) formatted and re-staged."
echo ""
exit 0
